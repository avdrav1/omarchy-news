{
  "schemaVersion": 1,
  "id": "av.news",
  "name": "News & Scores",
  "version": "1.4.0",
  "author": "av",
  "description": "Live sports scores (ESPN) and news headlines in a scrolling bar ticker with a detail popup",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "News & Scores",
    "description": "Live sports scores and news ticker",
    "category": "Info",
    "defaultSection": "left",
    "allowMultiple": false,
    "defaults": {
      "showScores": true,
      "leagues": "soccer/eng.1,basketball/nba",
      "teams": "",
      "tickerSources": "scores,tab1",
      "tab1": "news",
      "tab2": "business",
      "tab3": "technology",
      "tab4": "science",
      "tab5": "world",
      "tab1Url": "",
      "tab2Url": "",
      "tab3Url": "",
      "tab4Url": "",
      "tab5Url": "",
      "tickerTeams": "favorites",
      "alerts": "favorites",
      "hourCycle": 12,
      "tickerWidth": 240,
      "tickerSpeed": 40,
      "displayMode": "full"
    },
    "schema": [
      { "key": "showScores", "type": "boolean", "label": "Sports scores", "defaultValue": true, "description": "Off hides the Scores tab and ticker games and stops score fetches and alerts" },
      { "key": "leagues", "type": "string", "label": "Leagues", "defaultValue": "soccer/eng.1,basketball/nba", "description": "Comma-separated ESPN sport/league paths, e.g. soccer/eng.1, basketball/nba, football/nfl, hockey/nhl, baseball/mlb" },
      { "key": "teams", "type": "string", "label": "Favourite teams", "defaultValue": "", "description": "Comma-separated team abbreviations or names; favourites lead the ticker and get alerts" },
      { "key": "tickerSources", "type": "multiselect", "label": "Ticker shows", "defaultValue": "scores,tab1", "options": ["scores", "tab1", "tab2", "tab3", "tab4", "tab5"] },
      { "key": "tab1", "type": "enum", "label": "Article tab 1", "defaultValue": "news", "options": ["news", "business", "technology", "science", "world", "politics", "health", "climate", "arts", "omarchy", "custom", "off"] },
      { "key": "tab2", "type": "enum", "label": "Article tab 2", "defaultValue": "business", "options": ["news", "business", "technology", "science", "world", "politics", "health", "climate", "arts", "omarchy", "custom", "off"] },
      { "key": "tab3", "type": "enum", "label": "Article tab 3", "defaultValue": "technology", "options": ["news", "business", "technology", "science", "world", "politics", "health", "climate", "arts", "omarchy", "custom", "off"] },
      { "key": "tab4", "type": "enum", "label": "Article tab 4", "defaultValue": "science", "options": ["news", "business", "technology", "science", "world", "politics", "health", "climate", "arts", "omarchy", "custom", "off"] },
      { "key": "tab5", "type": "enum", "label": "Article tab 5", "defaultValue": "world", "options": ["news", "business", "technology", "science", "world", "politics", "health", "climate", "arts", "omarchy", "custom", "off"] },
      { "key": "tab1Url", "type": "string", "label": "Article tab 1 feed", "defaultValue": "", "description": "RSS or Atom URL, used when Article tab 1 is custom" },
      { "key": "tab2Url", "type": "string", "label": "Article tab 2 feed", "defaultValue": "", "description": "RSS or Atom URL, used when Article tab 2 is custom" },
      { "key": "tab3Url", "type": "string", "label": "Article tab 3 feed", "defaultValue": "", "description": "RSS or Atom URL, used when Article tab 3 is custom" },
      { "key": "tab4Url", "type": "string", "label": "Article tab 4 feed", "defaultValue": "", "description": "RSS or Atom URL, used when Article tab 4 is custom" },
      { "key": "tab5Url", "type": "string", "label": "Article tab 5 feed", "defaultValue": "", "description": "RSS or Atom URL, used when Article tab 5 is custom" },
      { "key": "tickerTeams", "type": "enum", "label": "Ticker games", "defaultValue": "favorites", "options": ["favorites", "all"], "description": "Favourites only while any has a game on; otherwise all games" },
      { "key": "alerts", "type": "enum", "label": "Alerts", "defaultValue": "favorites", "options": ["off", "favorites", "all"] },
      { "key": "hourCycle", "type": "enum", "label": "Clock", "defaultValue": 12, "options": [12, 24] },
      { "key": "tickerWidth", "type": "integer", "label": "Ticker width", "defaultValue": 240, "min": 80, "max": 800, "step": 10 },
      { "key": "tickerSpeed", "type": "integer", "label": "Ticker speed (px/s)", "defaultValue": 40, "min": 10, "max": 200, "step": 5 },
      { "key": "displayMode", "type": "enum", "label": "Display", "defaultValue": "full", "options": ["full", "icon", "text"] }
    ]
  }
}
